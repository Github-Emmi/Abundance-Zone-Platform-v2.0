# Makefile for CI/CD Automation
.PHONY: help install test lint format security clean coverage build deploy

help:  ## Show this help message
	@echo "Available targets:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}'

install:  ## Install all dependencies
	pip install -r requirements.txt
	pip install pytest pytest-cov pytest-asyncio black isort flake8 mypy bandit safety
	pre-commit install

test:  ## Run all tests
	pytest tests/test_smoke.py tests/unit/ -v --cov=app --cov-report=term-missing --cov-report=html

test-unit:  ## Run unit tests only
	pytest tests/unit/ -v --cov=app

test-integration:  ## Run integration tests only
	pytest tests/integration/ -v || true

test-coverage:  ## Run tests with coverage report
	pytest tests/ -v --cov=app --cov-report=html --cov-report=term-missing
	@echo "Coverage report generated in htmlcov/index.html"

lint:  ## Run all linters
	@echo "Running Black..."
	black --check app/ tests/
	@echo "Running isort..."
	isort --check-only app/ tests/
	@echo "Running Flake8..."
	flake8 app/ tests/ --max-line-length=120 --extend-ignore=E203,W503
	@echo "All linters passed!"

format:  ## Auto-format code
	black app/ tests/
	isort app/ tests/
	@echo "Code formatted!"

mypy:  ## Run type checking
	mypy app/ --ignore-missing-imports

security:  ## Run security checks
	@echo "Running Bandit..."
	bandit -r app/ -f json -o bandit-report.json
	@echo "Running Safety..."
	safety check --json > safety-report.json || true
	@echo "Security reports generated!"

clean:  ## Clean up generated files
	find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
	find . -type f -name "*.pyc" -delete
	find . -type f -name "*.pyo" -delete
	find . -type d -name "*.egg-info" -exec rm -rf {} + 2>/dev/null || true
	rm -rf .pytest_cache htmlcov .coverage coverage.xml
	@echo "Cleaned up!"

coverage:  ## Generate and open coverage report
	pytest tests/ --cov=app --cov-report=html
	open htmlcov/index.html || xdg-open htmlcov/index.html

build:  ## Build Docker image
	docker build -t abundance-zone-backend:latest .

run:  ## Run application locally
	uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

migrate:  ## Run database migrations
	alembic upgrade head

migrate-create:  ## Create new migration
	@read -p "Enter migration message: " msg; \
	alembic revision --autogenerate -m "$$msg"

docker-up:  ## Start all services with Docker Compose
	docker-compose up -d

docker-down:  ## Stop all services
	docker-compose down

docker-logs:  ## View Docker logs
	docker-compose logs -f backend

ci:  ## Run full CI pipeline locally
	@echo "=== Running CI Pipeline ==="
	$(MAKE) lint
	$(MAKE) security
	$(MAKE) test
	@echo "=== CI Pipeline Complete ==="

pre-commit:  ## Run pre-commit hooks
	pre-commit run --all-files

deploy-staging:  ## Deploy to staging
	@echo "Deploying to staging..."
	# Add staging deployment commands

deploy-production:  ## Deploy to production
	@echo "Deploying to production..."
	# Add production deployment commands
