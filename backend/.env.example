# ─────────────────────────────────────────────────────────────────────────────
# Abundance Zone Youth Management Platform v2.0 — Environment Variables
# With Neon PostgreSQL + Upstash Redis Integration
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
APP_NAME="Abundance Zone Youth Platform v2.0"
APP_VERSION=2.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
WORKERS=1
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Pooled connection (for FastAPI/Celery) - asyncpg compatible
DATABASE_URL=postgresql+asyncpg://[user]:[password]@[host]/[database]?sslmode=require

# Direct connection (for Alembic migrations only)
DATABASE_URL_SYNC=postgresql://[user]:[password]@[host]/[database]?sslmode=require

# Connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis (Upstash Redis) ───────────────────────────────────────────────────
# Get from: Upstash Console → Database → Details
REDIS_URL=rediss://default:[password]@[host]:6379

# Celery broker and result backend (use same Upstash Redis)
CELERY_BROKER_URL=rediss://default:[password]@[host]:6379/0
CELERY_RESULT_BACKEND=rediss://default:[password]@[host]:6379/1

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET_KEY=CHANGE_ME_generate_a_different_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI Services ──────────────────────────────────────────────────────────────
# Google Gemini (Primary AI)
GOOGLE_API_KEY=AIza...

# OpenRouter (Fallback AI)
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI GPT-4o Vision (OCR for receipts)
OPENAI_API_KEY=sk-proj-...

# ─── File Storage (Cloudinary or Firebase) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@abundancezone.org
EMAIL_FROM_NAME="Abundance Zone Youth Platform"

# ─── WhatsApp (Twilio) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Firebase (Push Notifications + Firestore) ───────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=...
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ─── Frontend URL ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=2

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ─── Cache TTL ────────────────────────────────────────────────────────────────
AI_CACHE_TTL_SECONDS=86400           # 24 hours
ANALYTICS_CACHE_TTL_SECONDS=2592000  # 30 days

# ─── Database Seed ────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@abundancezone.org
SEED_ADMIN_PASSWORD=SecurePassword123!
SEED_BRANCH_NAME="Oke-Afa 2 Branch"

# ─── Error Monitoring (Sentry) ────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
